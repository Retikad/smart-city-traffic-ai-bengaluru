TOMTOM_API_KEY=your_key_here
DATABASE_URL=sqlite:///./bengaluru_traffic.db
MODEL_DIR=model/saved_model
POLL_INTERVAL=300
INGEST_BATCH_MULTIPLIER=12
SNAPSHOT_SPACING_SECONDS=0
